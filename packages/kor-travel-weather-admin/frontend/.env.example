WEATHER_UI_TRUST_PROXY=false
DAGSTER_UI_INTERNAL_URL=http://127.0.0.1:14102
# Optional production Basic Auth for the UI/proxy boundary.
WEATHER_UI_USER=admin
WEATHER_UI_PASSWORD=
