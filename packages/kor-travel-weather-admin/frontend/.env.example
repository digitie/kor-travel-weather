WEATHER_API_INTERNAL_URL=http://127.0.0.1:14101
WEATHER_ADMIN_TOKEN=
NEXT_PUBLIC_DAGSTER_URL=http://127.0.0.1:14102
# VWorld WMTS browser key (public tile-service identifier; injected at build time)
NEXT_PUBLIC_VWORLD_API_KEY=
# Set this to a random secret in production; it signs the browser session cookie.
WEATHER_UI_SESSION_SECRET=
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
WEATHER_UI_TRUST_PROXY=false
# Browser Origin allowlist used by production CSRF protection.
WEATHER_UI_PUBLIC_ORIGIN=https://weather.digitie.mywire.org
DAGSTER_UI_INTERNAL_URL=http://127.0.0.1:14102
# Optional production Basic Auth for the UI/proxy boundary.
WEATHER_UI_USER=admin
WEATHER_UI_PASSWORD=
# Optional kor-travel-geo-compatible PBKDF2 hash; takes precedence when configured.
WEATHER_UI_PASSWORD_HASH=
# Set true only when HAProxy/nginx strips and appends the client X-Forwarded-For value.
# Production returns 503 rather than disabling throttling if no trusted IP is available.
