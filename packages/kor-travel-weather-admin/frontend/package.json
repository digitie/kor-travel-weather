{
  "name": "kor-travel-weather-admin-frontend",
  "version": "0.1.0-dev",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "22.23.1",
    "npm": "12.0.1"
  },
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 14105",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 14105",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:dependencies": "node node_modules/@kor-travel/ui/check-dependencies.mjs --lock package-lock.json --artifacts common-artifacts.json --source app --source components --source lib",
    "doctor": "react-doctor . --scope full --yes --no-telemetry --no-cache --blocking warning",
    "test:e2e:fixtures": "node scripts/run-browser-fixtures.mjs",
    "test:e2e:tiles": "node scripts/run-browser-fixtures.mjs --tile-fixture"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.1.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.2.0.tgz",
    "@radix-ui/react-focus-scope": "file:vendor/radix-ui-react-focus-scope-1.3.1+kortravel.fix.2.tgz",
    "@tanstack/react-query": "5.107.1",
    "echarts": "6.1.0",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.17.0",
    "motion": "14.12.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.1.tgz",
    "vworld-map-web": "file:vendor/vworld-map-web-1.0.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-dom": "5.30.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.30.1",
    "lightningcss": "file:vendor/lightningcss-1.33.0+nativecss.fix.4.tgz",
    "postcss": "8.5.32",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "lightningcss": "$lightningcss",
    "@radix-ui/react-focus-scope": "$@radix-ui/react-focus-scope"
  }
}
