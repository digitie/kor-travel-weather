# core
KOR_TRAVEL_WEATHER_ENV=development
KOR_TRAVEL_WEATHER_DATABASE_URL=postgresql+psycopg://weather@127.0.0.1:14100/weather
KOR_TRAVEL_WEATHER_GIT_COMMIT=local

# KMA / python-kma-api
KOR_TRAVEL_WEATHER_DATA_GO_KR_SERVICE_KEY=
KOR_TRAVEL_WEATHER_PROVIDER_HTTP_TIMEOUT_SECONDS=15
KOR_TRAVEL_WEATHER_PROVIDER_RETRIES=1
KOR_TRAVEL_WEATHER_ENABLED_PROVIDERS=["python-kma-api","open_meteo","wttr_in"]
KOR_TRAVEL_WEATHER_TARGETS=[]
KOR_TRAVEL_WEATHER_EXTRA_POINTS=
KOR_TRAVEL_WEATHER_MAX_GRIDS_PER_RUN=300
KOR_TRAVEL_WEATHER_MAX_TARGETS_PER_RUN=10000
KOR_TRAVEL_WEATHER_MAX_RESPONSE_ROWS_PER_RUN=1000000
KOR_TRAVEL_WEATHER_MAX_VALUES_PER_RUN=500000
KOR_TRAVEL_WEATHER_MAX_PAYLOAD_BYTES_PER_RUN=16777216

# API
KOR_TRAVEL_WEATHER_ADMIN_TOKEN=
# Fernet URL-safe key for encrypted provider overrides (generate one; never commit it)
KOR_TRAVEL_WEATHER_CREDENTIAL_ENCRYPTION_KEY=
KOR_TRAVEL_WEATHER_CORS_ORIGINS=["https://weather.digitie.mywire.org","http://127.0.0.1:14105"]
KOR_TRAVEL_WEATHER_API_BASE_URL=https://weather-api.digitie.mywire.org

# External provider credentials (leave empty to disable paid providers)
KOR_TRAVEL_WEATHER_WEATHERAPI_API_KEY=
KOR_TRAVEL_WEATHER_OPENWEATHERMAP_API_KEY=
KOR_TRAVEL_WEATHER_VISUAL_CROSSING_API_KEY=
KOR_TRAVEL_WEATHER_TOMORROW_IO_API_KEY=
KOR_TRAVEL_WEATHER_WEATHERBIT_API_KEY=
KOR_TRAVEL_WEATHER_WEATHERSTACK_API_KEY=
KOR_TRAVEL_WEATHER_ACCUWEATHER_API_KEY=
KOR_TRAVEL_WEATHER_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
KOR_TRAVEL_WEATHER_WTTR_IN_BASE_URL=https://wttr.in

# Production endpoints:
# API: https://weather-api.digitie.mywire.org
# Dagster: https://weather-dagster.digitie.mywire.org
# Admin web: https://weather.digitie.mywire.org

# Next.js server-only API target

# Docker Compose service-scoped values (WeatherSettings ignores these keys)
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
WEATHER_UI_USER=admin
WEATHER_UI_PASSWORD=change-me
WEATHER_UI_SESSION_SECRET=change-this-session-secret
# Local loopback default; set to https://weather.digitie.mywire.org for n150.
WEATHER_UI_PUBLIC_ORIGIN=http://127.0.0.1:14105
