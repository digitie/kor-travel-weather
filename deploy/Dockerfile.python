FROM ghcr.io/astral-sh/uv:0.11.21 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get clean

WORKDIR /app
ENV PATH="/opt/venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONPATH=/app/packages/kor-travel-weather-api/src:/app/packages/kor-travel-weather-dagster/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY pyproject.toml uv.lock README.md ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src
# python-airkorea-api is a path dependency of the weather runtime.  Copy the
# vendored library before ``uv sync`` so clean Docker builds resolve the same
# package that local/CI installs use.
COPY packages/python-airkorea-api ./packages/python-airkorea-api

ARG INSTALL_DAGSTER=0
RUN if [ "${INSTALL_DAGSTER}" = "1" ]; then \
      uv sync --locked --no-dev --extra dagster; \
    else \
      uv sync --locked --no-dev; \
    fi

COPY packages/kor-travel-weather-api/src ./packages/kor-travel-weather-api/src
COPY packages/kor-travel-weather-dagster/src ./packages/kor-travel-weather-dagster/src

# Bake the deployed revision into the image rather than injecting it at run
# time.  `.dockerignore` keeps `.git` out of the build context, so the value has
# to come from the caller -- but baking it means a restart cannot drift from the
# code, and a stale entry in a deployment env file cannot override it.  Last so
# a new revision does not invalidate the dependency layers above.
ARG GIT_COMMIT=unknown
ENV KOR_TRAVEL_WEATHER_GIT_COMMIT=${GIT_COMMIT}

EXPOSE 14101 14102 14103
