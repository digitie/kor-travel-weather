FROM ghcr.io/astral-sh/uv:0.11.21 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get clean

WORKDIR /app
ENV PATH="/opt/venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONPATH=/app/packages/kor-travel-weather-api/src:/app/packages/kor-travel-weather-dagster/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY pyproject.toml uv.lock README.md ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src

ARG INSTALL_DAGSTER=0
RUN if [ "${INSTALL_DAGSTER}" = "1" ]; then \
      uv sync --locked --no-dev --extra dagster; \
    else \
      uv sync --locked --no-dev; \
    fi

COPY packages/kor-travel-weather-api/src ./packages/kor-travel-weather-api/src
COPY packages/kor-travel-weather-dagster/src ./packages/kor-travel-weather-dagster/src

EXPOSE 14101 14102
