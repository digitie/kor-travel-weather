FROM node:22.23.1-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS dependencies
RUN npm install --global npm@12.0.1
WORKDIR /app
COPY packages/kor-travel-weather-admin/frontend/package.json \
     packages/kor-travel-weather-admin/frontend/package-lock.json \
     packages/kor-travel-weather-admin/frontend/.npmrc ./
COPY packages/kor-travel-weather-admin/frontend/vendor ./vendor
RUN npm ci --engine-strict --ignore-scripts --no-audit --no-fund

FROM dependencies AS builder
COPY packages/kor-travel-weather-admin/frontend ./
# VWorld browser keys are public tile-service identifiers.  Next inlines
# NEXT_PUBLIC_* values at build time, so pass the key as a build argument
# rather than relying on a runtime-only container environment.
ARG NEXT_PUBLIC_VWORLD_API_KEY=
ENV NEXT_PUBLIC_VWORLD_API_KEY=$NEXT_PUBLIC_VWORLD_API_KEY
# 공개 Dagster 링크도 Next.js 브라우저 번들 생성 시점에 고정한다.
ARG NEXT_PUBLIC_DAGSTER_URL=https://weather-dagster.digitie.mywire.org
ENV NEXT_PUBLIC_DAGSTER_URL=$NEXT_PUBLIC_DAGSTER_URL
RUN npm run build

FROM node:22.23.1-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runner
RUN npm install --global npm@12.0.1
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOME=/home/node \
    NPM_CONFIG_CACHE=/home/node/.npm \
    XDG_CACHE_HOME=/home/node/.cache
COPY --from=builder /app/package.json /app/package-lock.json /app/.npmrc ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
# next start serves static files from ./public relative to its cwd. The
# directory used to be empty, so its absence here was invisible; it now holds
# scripts/copy-maplibre-worker.mjs's output (maplibre-gl's worker + its
# maplibre-gl-shared.mjs sibling), generated by the builder stage's `npm run
# build` (prebuild hook). Without this line the worker 404s in the running
# container even though the image built cleanly -- the map mounts with no
# tiles, silently, in production only, never in `npm run dev`/`build && start`
# from one working directory.
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts /app/tsconfig.json ./
COPY --from=builder /app/middleware.ts ./middleware.ts

# 소유권은 이미지 산출물/cache에만 한정한다. host/env/다른 역할은 바꾸지 않는다.
RUN mkdir -p /app/.next/cache /home/node/.npm /home/node/.cache \
    && chown node:node /app/.next/cache /home/node/.npm /home/node/.cache
USER node

EXPOSE 14105
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "14105"]
